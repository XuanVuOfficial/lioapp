# Firebase Push Notification Service Account
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY_BASE64=your_base64_encoded_private_key
